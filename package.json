    "autosetup:link": "node scripts/autosetup/run.js --only link",
    "autosetup:assets": "node scripts/autosetup/run.js --only assets",
    "autosetup:game": "node scripts/autosetup/run.js --only game",
    "autosetup:icons": "node scripts/autosetup/run.js --only icons",
    "autosetup:privacy": "node scripts/autosetup/run.js --only privacy",
    "autosetup:webview": "node scripts/autosetup/run.js --only webview",
    "autosetup:cf-protocol": "node scripts/autosetup/run.js --only cf-protocol",
    "autosetup:rotate": "node scripts/autosetup/run.js --only rotate",
